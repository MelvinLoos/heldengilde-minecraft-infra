# Stack description for scripts/ on the laptop (the server gets /etc/hg-gitops/stack.env from Ansible).
# Use: export HG_ROOT=$HOME/hg-local; export HG_STACK_ENV=$PWD/local/stack.env
# Values reference HG_ROOT, so source this file through lib.sh (it expands at load time via `set -a`).
HG_ROOT=${HG_ROOT}
COMPOSE_FILE=${HG_REPO}/local/compose.yml
STATE_DIR=${HG_ROOT}
PANEL_URL=http://127.0.0.1:8081
PANEL_HOST=panel
PANEL_DB=sqlite
VOLUMES_DIR=${HG_ROOT}/lib/volumes
GITOPS_SRC=${HG_ROOT}/gitops
JARS_SRC=${HG_ROOT}/custom-jars
CONFIG_SRC=${HG_ROOT}/config
SERVER_NAME=${SERVER_NAME:-hg-paper}
NODE_NAME=hg-local
WINGS_STOP_CMD="docker compose -f ${HG_REPO}/local/compose.yml stop wings"
WINGS_START_CMD="docker compose -f ${HG_REPO}/local/compose.yml --profile wings start wings"
