# Non-secret server environment: the single source for the Pelican egg defaults
# (4-server/build-egg.sh) and the local boot test. Secrets are CFG_* variables set
# through the Pelican API from SOPS, never here. One KEY=VALUE per line.

# Runtime (ADR 0002, 0004)
TYPE=PAPER
VERSION=26.2
EULA=TRUE
UID=988
GID=988
MEMORY=16G
USE_AIKAR_FLAGS=true

# Config delivery (Git owns Zone 1)
COPY_CONFIG_DEST=/data
SYNC_SKIP_NEWER_IN_DESTINATION=false
REPLACE_ENV_DURING_SYNC=true
MODRINTH_PROJECTS=@/gitops/4-server/plugins.txt

# Server behaviour (replaces the hard-coded server.properties; itzg owns that file)
ONLINE_MODE=TRUE
ENFORCE_SECURE_PROFILE=true
DIFFICULTY=normal
PVP=false
SPAWN_PROTECTION=64
MAX_PLAYERS=30
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6
MOTD=De Heldengilde - Veilige Avonturen en Co-op Puzzels

# Game rules via RCON at startup. keepInventory is a gamerule, not a server property; on 26.x it is snake_case.
RCON_CMDS_STARTUP=gamerule keep_inventory true

# Reproducibility and supply chain
PAPER_BUILD=135
SKIP_DOWNLOAD_DEFAULTS=true
