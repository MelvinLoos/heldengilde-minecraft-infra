# Managed by Ansible (pelican_panel). Read by scripts/lib.sh. No secrets (those are in backup.env).
HG_ROOT={{ hg_root }}
COMPOSE_FILE={{ hg_root }}/panel/compose.yml
STATE_DIR={{ hg_root }}/state
PANEL_URL=http://127.0.0.1:8081
PANEL_HOST={{ hg_panel_domain }}
PANEL_DB={{ hg_panel_db }}
VOLUMES_DIR={{ hg_volumes_dir }}
GITOPS_SRC={{ hg_root }}/gitops
JARS_SRC={{ hg_root }}/custom-jars
CONFIG_SRC={{ hg_root }}/gitops/4-server/config
SERVER_NAME={{ hg_server_name }}
NODE_NAME={{ inventory_hostname }}
NODE_FQDN={{ hg_wings_domain }}
NODE_SCHEME={{ hg_node_scheme }}
NODE_BEHIND_PROXY=1
NODE_CONNECT_PORT={{ hg_node_connect_port }}
ADMIN_EMAIL={{ hg_admin_email }}
