APP_URL=https://{{ hg_panel_domain }}
BEHIND_PROXY=true
TRUSTED_PROXIES=0.0.0.0/0,::/0
APP_ENV=production
APP_DEBUG=false
XDG_DATA_HOME=/pelican-data
MAIL_DRIVER=log
{% if hg_panel_db == 'mariadb' %}
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE={{ hg_panel_db_name }}
DB_USERNAME={{ hg_panel_db_user }}
DB_PASSWORD={{ hg_panel_db_password }}
{% else %}
DB_CONNECTION=sqlite
DB_DATABASE=/pelican-data/database/database.sqlite
{% endif %}
