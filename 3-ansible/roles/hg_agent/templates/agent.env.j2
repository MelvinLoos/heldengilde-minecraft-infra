# Managed by Ansible (hg_agent). No secrets here; deploy keys live in {{ hg_root }}/state.
HG_ROOT={{ hg_root }}
HG_VOLUMES_DIR={{ hg_volumes_dir }}
HG_SERVER_NAME={{ hg_server_name }}
HG_PANEL_URL=http://127.0.0.1:8081
HG_PANEL_HOST={{ hg_panel_domain }}
HG_INFRA_BRANCH={{ hg_infra_branch }}
HG_CONTENT_REPO={{ hg_content_repo }}
HG_CONTENT_BRANCH={{ hg_content_branch }}
