# Managed by Ansible (hg_backups).
HG_ROOT={{ hg_root }}
COMPOSE_FILE={{ hg_root }}/panel/compose.yml
PANEL_DB={{ hg_panel_db }}
RETENTION_DAYS={{ hg_db_dump_retention_days }}
{% if hg_backup_enabled %}
S3_ENDPOINT={{ hg_s3_endpoint }}
S3_REGION={{ hg_s3_region }}
S3_BUCKET={{ hg_s3_bucket }}
S3_KEY={{ hg_s3_key }}
S3_SECRET={{ hg_s3_secret }}
{% endif %}
